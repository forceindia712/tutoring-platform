rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // WAŻNE: zamień teacher@example.com na e-mail swojego konta nauczyciela.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'teacher@example.com';
    }

    // Pliki materiałów wgrywa wyłącznie nauczyciel.
    match /materials/{allPaths=**} {
      allow read, write: if isTeacher();
    }
  }
}
