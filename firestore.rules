rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // E-mail konta nauczyciela zalogowanego przez Firebase Auth.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'albertbilskii@gmail.com';
    }

    // Dane może czytać i zapisywać wyłącznie nauczyciel.
    // Uczeń nigdy nie łączy się z Firestore bezpośrednio – jego dane
    // pobiera serwer aplikacji przez Firebase Admin SDK po access tokenie.
    match /students/{studentId} {
      allow read, write: if isTeacher();
    }

    match /meetings/{meetingId} {
      allow read, write: if isTeacher();
    }

    match /materials/{materialId} {
      allow read, write: if isTeacher();
    }

    match /student_infos/{infoId} {
      allow read, write: if isTeacher();
    }

    // Stan i historia powiadomień: zapisuje wyłącznie serwer (Admin SDK
    // omija reguły). Nauczyciel może je czytać i usuwać (np. razem z uczniem).
    match /notification_states/{stateId} {
      allow read, delete: if isTeacher();
      allow create, update: if false;
    }

    match /notification_attempts/{attemptId} {
      allow read, delete: if isTeacher();
      allow create, update: if false;
    }
  }
}
