# Konfiguracja publiczna Firebase (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Konto serwisowe – tylko po stronie serwera (NIGDY w kodzie klienckim).
# Używane przez strony ucznia /s/[token] do bezpiecznego odczytu Firestore.
# Pobierz z: Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Powiadomienia (e-mail przez Gmail SMTP) – tylko po stronie serwera.
# Adres nauczyciela – musi być taki sam jak w firestore.rules.
TEACHER_EMAIL=
# Gmail nauczyciela i hasło aplikacji (konto Google → Bezpieczeństwo → Hasła aplikacji; wymaga weryfikacji dwuetapowej).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Publiczny adres aplikacji bez ukośnika na końcu, np. https://tutoring-platform-smoky.vercel.app
APP_BASE_URL=
# Opcjonalnie: nazwa nadawcy widoczna w mailu (domyślnie "Zajęcia").
MAIL_FROM_NAME=
